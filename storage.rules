rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─── Modelos GLB ─────────────────────────────────────
    // Leitura pública (viewer não-autenticado precisa baixar o .glb).
    // Escrita restrita a admins da empresa dona do path.
    match /empresas/{empresaId}/produtos/{arquivo=**} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.papel == 'admin'
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.empresaId == empresaId
        // Aceita .glb / .gltf (até 50 MB) — ajustar se necessário.
        && request.resource.size < 50 * 1024 * 1024
        && (request.resource.contentType.matches('model/.*')
            || arquivo.matches('.*\\.glb$')
            || arquivo.matches('.*\\.gltf$'));
    }
  }
}
