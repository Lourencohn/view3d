rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Usuários ─────────────────────────────────────────
    // Cada usuário lê/escreve apenas o próprio documento.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ─── Empresas ─────────────────────────────────────────
    // Usuário só lê a empresa à qual pertence.
    match /empresas/{empresaId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.empresaId == empresaId;
      // Escrita só via Console / função administrativa por enquanto.
      allow write: if false;
    }

    // ─── Produtos ─────────────────────────────────────────
    // Leitura é PÚBLICA — necessária para a página do viewer funcionar
    // sem login. Escrita só por admins da própria empresa.
    match /produtos/{produtoId} {
      allow read: if true;

      allow create: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel == 'admin'
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.empresaId == request.resource.data.empresaId;

      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel == 'admin'
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.empresaId == resource.data.empresaId;
    }
  }
}
